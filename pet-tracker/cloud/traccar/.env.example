# Copy to .env (never commit .env).
# Domain pointing at this server, for HTTPS on the Traccar web UI/API.
TRACCAR_DOMAIN=traccar.example.com
# Your Supabase project URL (Settings -> API).
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Same value as the Supabase secret TRACCAR_FORWARD_SECRET (32+ random characters):
#   openssl rand -hex 24
TRACCAR_FORWARD_SECRET=
