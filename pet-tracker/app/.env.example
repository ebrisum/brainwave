# Supabase project (Dashboard > Project Settings > API). The anon/publishable key is
# safe to ship in an app: row-level security decides what each user can see.
# Leave empty to run the app in demo mode only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the web build of this app is hosted (e.g. https://app.yourbrand.nl).
# Live links for a lost cat (/share/<token>) and invite links (/join?code=...)
# use it, so people without the app can open them. Empty: cattracker:// links.
EXPO_PUBLIC_WEB_URL=
# Shown under Me -> Help & support and Privacy & data.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Web map (browser build only; phones use Apple/Google Maps). Default:
# OpenFreeMap (free, no key, OpenStreetMap data). Any MapLibre style URL works.
EXPO_PUBLIC_MAP_STYLE=
EXPO_PUBLIC_MAP_STYLE_DARK=
